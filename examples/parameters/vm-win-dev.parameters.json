{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "adminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/22222222-2222-2222-2222-222222222222/resourceGroups/rg-secrets-dev/providers/Microsoft.KeyVault/vaults/kv-vm-secrets"
        },
        "secretName": "vm-win-dev-admin-password"
      }
    },
    "createNic": {
      "value": true
    },
    "createPublicIp": {
      "value": false
    },
    "extensions": {
      "value": []
    },
    "identity": {
      "value": {
        "type": "SystemAssigned"
      }
    },
    "location": {
      "value": "ukwest"
    },
    "nicName": {
      "value": "vm-win-dev-nic"
    },
    "nicProperties": {
      "value": {
        "dnsSettings": {
          "dnsServers": []
        },
        "enableAcceleratedNetworking": false,
        "enableIPForwarding": false,
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "primary": true,
              "privateIPAddressVersion": "IPv4",
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "/subscriptions/22222222-2222-2222-2222-222222222222/resourceGroups/rg-network-dev/providers/Microsoft.Network/virtualNetworks/vnet-shared-dev/subnets/snet-shared"
              }
            }
          }
        ]
      }
    },
    "osProfile": {
      "value": {
        "adminUsername": "azureadmin",
        "allowExtensionOperations": true,
        "computerName": "vm-win-dev",
        "windowsConfiguration": {
          "enableAutomaticUpdates": true,
          "patchSettings": {
            "patchMode": "AutomaticByOS"
          },
          "provisionVMAgent": true,
          "timeZone": "GMT Standard Time"
        }
      }
    },
    "plan": {
      "value": {}
    },
    "publicIpName": {
      "value": "vm-win-dev-pip"
    },
    "publicIpProperties": {
      "value": {}
    },
    "tags": {
      "value": {
        "Environment": "dev",
        "Owner": "platform"
      }
    },
    "vmName": {
      "value": "vm-win-dev"
    },
    "vmProperties": {
      "value": {
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        },
        "hardwareProfile": {
          "vmSize": "Standard_D2s_v5"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "/subscriptions/22222222-2222-2222-2222-222222222222/resourceGroups/rg-vms-dev/providers/Microsoft.Network/networkInterfaces/vm-win-dev-nic",
              "properties": {
                "deleteOption": "Detach",
                "primary": true
              }
            }
          ]
        },
        "priority": "Regular",
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "storageProfile": {
          "dataDisks": [],
          "imageReference": {
            "offer": "WindowsServer",
            "publisher": "MicrosoftWindowsServer",
            "sku": "2022-datacenter-azure-edition",
            "version": "latest"
          },
          "osDisk": {
            "caching": "ReadWrite",
            "createOption": "FromImage",
            "deleteOption": "Detach",
            "managedDisk": {
              "storageAccountType": "Premium_LRS"
            },
            "name": "vm-win-dev-os",
            "osType": "Windows"
          }
        }
      }
    },
    "zones": {
      "value": []
    }
  }
}
